{
  "name": "fapost/foundation",
  "description": "FAPost public contract layer for Solutions, Plugins and external integrations",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.4",
    "illuminate/support": "^11.0 || ^12.0",
    "psr/http-message": "^1.1 || ^2.0",
    "spatie/laravel-data": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "FAPost\\Foundation\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FAPost\\Foundation\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": []
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
